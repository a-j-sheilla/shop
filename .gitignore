*.sublime-project
*.sublime-workspace

# Ignore TextMate files
*.tmproj
*.tmproject
tmtags

# Ignore CTags files
tags
TAGS

# Ignore backup files
*.bak
*.backup
*.tmp

# Ignore log files
*.log

# Ignore temporary files
tmp/
temp/

# Ignore node modules and npm files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore webpack compiled files
/public/webpack/
/public/packs/
/public/packs-test/

# Ignore carrierwave uploads
/public/uploads/

# Ignore bootsnap cache
/tmp/cache/bootsnap*

# Ignore Spring files
/spring/*.pid

