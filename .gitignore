/config/secrets.yml
/config/database.yml.example

# Ignore local configuration files
/config/application.yml
/config/local_env.yml

# Ignore Redis dump file
dump.rdb

# Ignore Elasticsearch data
/elasticsearch/

# Ignore Solr data
/solr/

# Ignore pow files
.powrc
.powder

# Ignore rbenv files
.ruby-version
.ruby-gemset

# Ignore RVM files
.rvmrc

